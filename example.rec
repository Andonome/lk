%rec: example
%key: name

name: Convert taskwarrior database to a recfile
filename: task2rec.sh
bin: recsel
bin: mlr
bin: task
tag: data
usage: ./{{filename}}
content: #!/bin/sh
+ 
+ set -e
+ 
+ recfile=task.rec
+ 
+ no_tasks="$(task count)"
+ 
+ uuids="$(task uuids)"
+ 
+ cat > "$recfile" << EOF
+ %rec: Task
+ %doc: Tasks from taskwarrior
+ %key: uuid
+ %type: uuid uuid
+ %type: project line
+ %type: urgency real
+ %type: status enum completed deleted pending
+  
+ EOF
+ 
+ echo "$uuids" | while read id ; do
+     task $id export +     | mlr --ijson --orecutils cat +     | sed '/^\w\+\.\w\+: /s/\.\w\+:/:/; s/\.\w\./_/' +     | recsel +     | sed '1i\ ' +     | tee -a "$recfile"
+ done
+ 
+ cat >> "$recfile" << EOF
+ 
+ %rec: Annotation
+ %doc: Notes on tasks
+ %type: task rec Task
+  
+ EOF
+ 
+ recsel "$recfile" -t Task -e 'annotations_entry != ""' +     -p 'uuid:task,annotations_entry:entry,annotations_description:description' | tee -a "$recfile"
+ 
+ recset -t Task "$recfile" -f annotations_entry -d
+ recset -t Task "$recfile" -f annotations_description -d
+ 
+ recfix "$recfile"

name: Default systemd service file
filename: default.service
bin: systemd
tag: service
tag: system
usage: mv {{filename}} /usr/lib/systemd/system/
+ systemctl daemon-reload
+ systemctl enable --now {{filename}}
note: Basic systemd service file
content: [Unit]
+ 
+ Description={{script}}
+ 
+ [Service]
+ 
+ ExecStart=/home/{{user}}/.local/bin/{{script}}.sh
+ 
+ Restart=always
+ 
+ Type=simple
+ 
+ User={{user}}
+ 
+ Group={{group}}
+ 
+ [Install]
+ 
+ WantedBy=multi-user.target
+ 
+ Alias=test.service
+ 

name: Example sc-im file
filename: food.sc
bin: sc-im
tag: data
tag: csv
usage: {{bin}} {{filename}}
note: Basic sc-im example of adding and averaging
content: # This data file was generated by the Spreadsheet Calculator Improvised (sc-im)
+ # You almost certainly shouldn't edit it.
+ 
+ newsheet "Food"
+ movetosheet "Food"
+ offscr_sc_cols 0
+ offscr_sc_rows 0
+ nb_frozen_rows 1
+ nb_frozen_cols 0
+ nb_frozen_screenrows 2
+ nb_frozen_screencols 0
+ format A 24 1 0
+ format B 13 2 0
+ format 0 2
+ format 4 2
+ format 10 2
+ freeze 0
+ label A0 = "Food by Weight"
+ leftstring B0 = "No. Meals"
+ leftstring A1 = "Ajvar"
+ let A1 = 5
+ let B1 = A1*$A$10
+ leftstring A2 = "Apples"
+ let A2 = 3
+ let B2 = A2*$A$10
+ leftstring A3 = "Rocket"
+ let A3 = 0.2
+ let B3 = A3*$A$10
+ leftstring A4 = "Beli Cheese"
+ let A4 = 1
+ let B4 = A4*$A$10
+ leftstring A6 = "Total"
+ let A6 = @sum(A1:A4)
+ leftstring B6 = "Total"
+ let B6 = @sum(B1:B4)
+ leftstring A7 = "Average"
+ let A7 = @avg(A1:A4)
+ leftstring A10 = "Weight of Meal"
+ let A10 = 0.3
+ pad 4 A0:A4
+ pad 2 B0:B4
+ pad 4 A6:A8
+ pad 2 B6
+ pad 4 A10
+ goto A10

name: Example makefile producing html from markdown
filename: lowdown.mk
bin: make
bin: lowdown
bin: fortune
tag: writing
tag: markdown
usage: {{bin}} -f {{filename}} example
content: output: all
+ 
+ .PHONY: example
+ example: html/foot.html html/head.html
+ 	mkdir -p articles/
+ 	fortune > articles/fort_1.md
+ 	fortune > articles/fort_2.md
+ 
+ HTML = $(patsubst articles/%.md,public/%.html,$(wildcard articles/*.md))
+ 
+ $(HTML): public/ articles/ $(wildcard html/*)
+ 
+ html/head.html:
+ 	@mkdir $(@D)
+ 	echo '<head> Something about CSS probably </head>' > $@
+ 	echo '<body>' >> $@
+ 
+ html/foot.html: html/head.html
+ 	echo '</body>' >> $@
+ 
+ public/%.html : articles/%.md
+ 	cat html/head.html > $@
+ 	lowdown $< >> $@
+ 	cat html/foot.html >> $@
+ 
+ .PHONY: all
+ all : $(HTML)
+ 
+ articles/:
+ 	mkdir $@
+ 
+ public/:
+ 	mkdir $@
+ 
+ clean :
+ 	rm -rf public html

name: Default makefile
filename: Makefile
bin: make
tag: system
usage: make
content: ### Variables
+ .DEFAULT_GOAL = help
+ PAGER ?= $(shell command -v mdless bat less | head -1 )
+ EDITOR ?= vi
+ 
+ requirements += lowdown
+ 
+ ### Dependencies
+ 
+ ### Patterns
+ 
+ 
+ ### Phonies
+ 
+ .PHONY: help
+ help:
+ 	@awk 'BEGIN {FS = ":.*?## "} /^[0-9a-zA-Z._-]+:.*?## / {printf "\033[36m%s\033[0m : %s\n", $$1, $$2}' $(MAKEFILE_LIST) | sort | column -s ':' -t
+ 
+ .PHONY: check
+ check: ## Check you have the required dependencies
+ 	@$(foreach dep, $(requirements), type $(dep) >/dev/null || echo "Install $(dep)." ; )
+ 
+ .PHONY: clean
+ clean: ## Remove generated files.
+ 	$(RM) $(defaults)

name: Issues tracker
filename: Makefile
bin: make
tag: comfy
tag: tracker
tag: issue
content: hdr = @printf "\n\033[37;1;4m%s\033[0m\n"
+ msg = @printf "\033[37;1m%s\033[0m\n"
+ 
+ issues = $(wildcard open/*) $(wildcard closed/*)
+ 
+ number_of_issues != echo $(issues) | wc -w
+ next_number != echo $$(( $(number_of_issues) + 1 ))
+ 
+ name = open/issue_$(number_of_issues).md
+ next_name = open/issue_$(next_number).md
+ 
+ last_modified != ls -t open/* 2>/dev/null | head -1
+ ifndef last_modified
+ setup:
+ 	@mkdir open closed
+ 	@git init
+ 	@echo '---' > open/issue_1.md
+ 	@echo 'title: Setup git' >> open/issue_1.md
+ 	@echo 'priority: high' >> open/issue_1.md
+ 	@printf 'responsible: ' >> open/issue_1.md
+ 	@git config user.name >> open/issue_1.md
+ 	@echo '---' >> open/issue_1.md
+ 	@echo 'Push to a remote repository' >> open/issue_1.md
+ 	@git add $(MAKEFILE_LIST) open/issue_1.md
+ 	@git commit -m'Init the git!'
+ 	@sed -i '/ifndef last_modified/,/^endif/d' Makefile
+ 	$(info Check issue 1)
+ 	$(info Run make again)
+ endif
+ 
+ open_issues = $(wildcard open/*)
+ closed_issues = $(patsubst open/%, closed/%, $(open_issues))
+ 
+ EDITOR ?= vi
+ 
+ close_issue_command = @git commit --message "Close $$(basename -s .md $(last_modified) | tr '_' ' ')"
+ 
+ random_helper = $(shell git shortlog -se | sort -R | head -1 | cut -d '<' -f2 | tr -d '>')
+ 
+ contact = Get outside help
+ ifeq ($(MAKECMDGOALS),help)
+   contact = Email $(random_helper)
+ endif
+ 
+ help:
+ 	@printf "\033[36m%s\t\033[0m %s\n" "help" "$(contact)"
+ 	@printf "\033[36m%s\t" "done"
+ 	@printf "\033[0m %s " "Close $$(basename -s .md $(last_modified) | tr '_' ' ')"
+ 	@printf "\033[0m %s\n" "[$$(grep -Pom1 'title: \K.*' $(last_modified))]"
+ 	@awk 'BEGIN {FS = ":.*?## "} /^[0-9a-zA-Z._-]+:.*?## / {printf "\033[36m%s\033[0m : %s\n", $$1, $$2}' $(MAKEFILE_LIST) | column -s ':' -t
+ 
+ $(closed_issues): closed/%.md: open/%.md
+ 	@git add $<
+ 	@git mv $< $@
+ 	$(close_issue_command)
+ 
+ .PHONY: issue
+ issue: $(next_name) ## Make an issue
+ 	$(info Created $<)
+ 	$(info Remember to push!)
+ 
+ $(next_name):
+ 	@echo '---' > $@
+ 	@read -p 'Title? ' title && echo title: $$title >> $@
+ 	@echo priority: low >> $@
+ 	@echo responsible: $(shell git config user.name) >> $@
+ 	@echo '---' >> $@
+ 	@printf '\n\n' >> $@
+ 	@$(EDITOR) +7 $@
+ 	@git add $@
+ 	@git commit --quiet --message "$$(grep -Pom1 'title: \K.*' $@)"
+ 
+ .PHONY: done
+ done:
+ 	$(info Closing $(shell basename -s .md $(last_modified) | tr '_' ' '))
+ 	@git add $(last_modified)
+ 	@git mv $(last_modified) closed/
+ 	$(close_issue_command)
+ 
+ .PHONY: stats
+ stats: ## Summarise issue
+ 	$(hdr) "Priorities"
+ 	$(msg) "$$(head -n 7 $(wildcard open/*) | sort | grep -Po 'priority: \K.*' | uniq -c)"
+ 	$(msg) "$$(ls closed/ | wc -l) closed"
+ 	$(hdr) "Holders"
+ 	$(msg) "$$(head -n 7 $(wildcard open/*) | grep -Po 'responsible: \K.*' | tr [:upper:] [:lower:] | sort | uniq -c)"
+ 
+ .PHONY: rundown
+ rundown: ## Summarize events
+ 	@printf "\033[33;5m# %s\033[0m\n" "Outstanding Calamities"
+ 	@$(foreach bug, $(wildcard open/*.md), a="$$(lowdown -X responsible $(bug))" && n="$$(echo $(bug) | cut -d_ -f2 | cut -d. -f1)" && t="$$(lowdown -X title $(bug))" && echo "$$n: $$t ($$a)" ;)

name: RSS feed
filename: rss.xml
note: Only 'description', 'link', and 'title' are required.
+ 
+ Extra fields include 'textInput' (for a paragraph about the feed), 'skipHours' (for the hours to wait before refreshing), and 'language'.
content: <?xml version="1.0" encoding="UTF-8" ?>
+ <rss version="2.0">
+ 
+ <channel>
+   <title>{{title}}</title>
+   <link>{{url}}</link>
+   <generator>Recutils</generator>
+   <docs>https://www.w3schools.com/XML/xml_rss.asp</docs>
+   <skipDays>{{frequency}}</skipDays>
+   <description>{{description}}</description>
note: Output the next content field separately to produce multiple post items.
content:   <item>
+     <guid>{{post_id}}</guid>
+ 	<category>{{post_category}}</category>
+ 	<pubDate>{{post_date}}</pubDate>
+     <title>{{post_title}}</title>
+     <link>{{url}}/{{post_link}}</link>
+     <description>{{post_description}}</description>
+ 	<source>{{post_source}}</source>
+   </item>
note: The last content field closes the XML tags opened in the first content field.
content: </channel>
+ 
+ </rss>

filename: mpres.md
name: TUI Presentation Slides
bin: lowdown
tag: markdown
tag: presentation
usage: mdp ${file}
content: %title: Presenting with `mdp`
+ %author: ghost
+ %date: 2016-02-07
+ 
+ # Sizes
+ 
+ Make the terminal font bigger.
+ 
+ ^
+ ...but not too big, or the slides won't have enough space!
+ 
+ 
+ ***
+ 
+ # Features
+ 
+ Start a new slide with `***`.
+ 
+ ^
+ 
+ -> ## Centred Headers <-
+ 
+ Put stuff right in the middle with `-> this <-`.
+ 
+ ^
+ 
+ ## Code
+ 
+     echo "Indent with four spaces to start"
+     echo "a code block"
+ 
+ ^
+ 
+ Or the usual way:
+ 
+     ```python
+     import os
+     ```
+ 
+ ## Quotes
+ 
+ > Quotes are great.
+ > 
+ > - *Me*
+ 
+ ***
+ 
+ # Beware!
+ 
+ - When you can't see the words, try `mdp -ie`.
+ ^
+ - All files must be created specifically for mdp!
+ ^
+ - You only have two header levels.
+ ^
+ - You can't use random markdown files.
+ ^
+ - There are no tables.
+ ^
+ - Ordered lists are not ordered automatically.
+ ^
+ - Always check how the projector works before you begin.
+ ^
+ - ...especially when using a tiling window manager.
+ ^
+ - There is no spoon.

name: Makefile to track the contents of /etc/
filename: Makefile
bin: make
bin: fzf
tag: system
tag: maintenance
usage: make new
+ make
+ git -C etc/ init
+ git -C etc/ add -A
+ git -C etc/ commit --message='Track etc files'
+ 
content: .SILENT:
+ 
+ 
+ define track
+ #!/bin/sh
+ 
+ mk=list.mk
+ config="$$(cd /etc/ && fzf --multi)"
+ 
+ echo "$${config}" | while read file ; do
+     grep -q "$${config}" "$${mk}" 2>/dev/null || { 
+ 		printf "\ndefault += etc/$${config}\n" >> "$${mk}"
+ 		printf "\netc/$${config}: /etc/$${config}\n\tcp --parents %s\n\n" '$$< .' >> "$${mk}"
+ 	}
+ done
+ endef
+ 
+ include list.mk
+ 
+ .PHONY: help
+ help:
+ 	@awk 'BEGIN {FS = ":.*?## "} /^[0-9a-zA-Z._-]+:.*?## / {printf "\033[36m%s\033[0m : %s\n", $$1, $$2}' $(MAKEFILE_LIST) | sort | column -s ':' -t
+ 
+ .PHONY: all
+ all: $(default) ## Update all files
+ 
+ list.mk:
+ 	echo '.DEFAULT_GOAL = all' > $@
+ 	$(MAKE) help
+ 
+ track:
+ 	$(file > $@, $(track) )
+ 	chmod u+x $@
+ 	$(MAKE) help
+ 
+ .PHONY: new
+ new: track ## Track a file in /etc/
+ 	./$<

name: NB: take linked  notes with recutils
usage: ./{{filename}}
filename: nb
bin: recsel
bin: netcache
tag: zettelkasten
tag: notes
content: #!/bin/sh
+ 
+ set -e
+ 
+ db=${XDG_PROJECTS_DIR:-$HOME}/nb.rec
+ FZF=fzf
+ 
+ export OFFPUNK_CACHE_PATH=~/kn/links
+ 
+ trap commit EXIT
+ 
+ commit(){
+     cd "$(dirname "$db")"
+     [ ! -r .git ] || { 
+         git add "$db"
+         [ -z "$message" ] || git commit -m "NB: $message"
+     }
+ }
+ 
+ [ -r "$db" ] || {
+     echo need "$db"
+     mkdir -p "$(dirname "$db")"
+     cat >> "$db" <<EOF
+ %rec: note
+ %doc: unstructured bits of thought
+ %key: id
+ %allowed: date head tag url author body quote path link
+ %type: id int
+ %auto: id
+ %type: date date
+ %auto: date
+ %type: link rec note
+ %constraint: id != link
+ %constraint: #head = 0 => #quote
+ %type: head,path line
+ %type: tag word
+ %typedef: word regexp /^[a-z]+[0-9]*$/
+ 
+ EOF
+ }
+ 
+ id=$(recsel "$db" -t note -CR id | tail -1)
+ id="$(( id + 1 ))"
+ 
+ parser="$(command -v netcache )"
+ graph_format="$(printf '%s\n' "[ {{id}} ] --> [ {{link}} ]")"
+ 
+ graph_box="$(printf '%s\n' '[ {{id}} ]{label: {{id}} {{tag}} ;}')"
+ 
+ format='# {{head}}
+ 
+ **({{id}})** < {{tag[0]}} {{tag[1]}} {{tag[2]}} {{tag[3]}} > {{link[0]}} {{link[1]}} {{link[2]}} {{link[3]}}
+ 
+ > {{quote}}
+ 
+ {{body}}
+ 
+ {{url}}
+ 
+ ---
+ '
+ 
+ while getopts 'mreblf:p:a:g:k:q:t:u:v:' OPTION; do
+   case "$OPTION" in
+     b) #^# -b Make a graph with graph-easy
+     {
+     recsel -t note "$db"  | recfmt "$graph_box"
+     for x in $(seq 0 8); do
+         recsel -t note "$db" -e "link[$x] != ''" -p "id,link[$x]" | recfmt "$graph_format"
+     done 
+     } | graph-easy --boxart | less -RSi
+     exit 0
+     ;;
+     m) #^# -m Show a dangling note
+     linkless="$(recsel "$db" -t note -e "link = ''" -CP id | sort -R )"
+     for id in $linkless ; do
+         [ "$(recsel "$db" -t note -e "link = '${id}'" -c )" -gt 0 ] \
+             && continue
+         recsel "$db" -t note -e "id = $id" | recfmt "$format" \
+             | lowdown -stterm \
+             | less -RFi \
+         && break
+     done
+     exit 0
+     ;;
+     e) #^# -e Edit database
+       $EDITOR "$db"
+       shift "$(($OPTIND -1))"
+       [ -z "$1" ] && message="edits" || message="$*"
+       exit 0
+     ;;
+     p) #^# -p Tag previous note
+       id="$(( id - 1 ))"
+       for t in $OPTARG; do
+         recset --verbose "$db" -t note -n "$id" -f tag -a "$t"
+       done
+       message="add $OPTARG to $id"
+       exit 0
+       ;;
+     g) #^# -g Get notes
+       recsel "$db" -t note -iq "$OPTARG" -p id,tag,link,head | recsel -m 3 | recfmt "$format" | lowdown -stterm
+       exit 0
+       ;;
+     r) #^# -r Random note
+       recsel -t note "$db" -e '#tag = 0'
+       topic="$(recsel -t note "$db" -m 1 -CP tag | head -1)"
+       recsel -t note "$db" -e "tag = '${topic}'" | recfmt "$format" | lowdown -stterm | less -RFi
+       exit 0
+       ;;
+     t) #^# -t "$tag1 $tag2" Long note, no body
+       [ -z "$tags" ] && tags="$OPTARG" || tags="$tags $OPTARG"
+       ;;
+     a) #^# -a Set author
+       author="$OPTARG"
+       ;;
+     l) #^# -l link $id to $id
+       shift "$(($OPTIND -1))"
+       case "$#" in
+         0)
+         recsel "$db" -t note -e "link = ''" | recsel -m1 | recfmt "${format}" | lowdown -tterm
+         exit 0
+         ;;
+         1)
+         [ "$1" -gt -1 ] 2>/dev/null || exit 1
+         recsel "$db" -t note -e "id = ${1}" | recfmt "${format}" | lowdown -tterm
+         exit 0
+         ;;
+         2)
+         recset "$db" -t note -e "id = ${1}" -f link -a ${2}
+         message="link $1 to $2"
+         exit 0
+         ;;
+         *)
+         echo "One link only"
+         exit 4
+         ;;
+       esac
+       exit 0
+       ;;
+     k) #^# -k Set link
+       links="$OPTARG"
+       ;;
+     q) #^# -q Quote
+       quote="$OPTARG"
+       ;;
+     f) #^# -f Note a relevant file
+       file="$OPTARG"
+       ;;
+     u) #^# -u Set a URL
+       url="$OPTARG"
+       ;;
+     v) #^# -v View note with everything attached.
+       [ "$OPTARG" -ge 0 ] || {
+         echo "Give an ID number"
+         exit 1
+       }
+       recsel "$db" -t note -e "id = ${OPTARG}" | recfmt "${format}" | lowdown -tterm
+       exit 0
+       ;;
+     ?)
+       echo "Usage: "
+       echo "$(basename $0) [note]"
+       grep -oP '#\^# \K.*' "$0"
+       exit 0
+       ;;
+   esac
+ done
+ shift "$(($OPTIND -1))"
+ 
+ head="$*"
+ 
+ trap cleanup EXIT
+ 
+ cleanup(){
+     [ ! -r "$tmp" ] || rm "$tmp"
+     commit
+ }
+ 
+ tmp="$( mktemp --suffix .md )"
+ 
+ [ $(( ${#head} * ${#tags} )) -gt 10 ] || {
+     echo "$head" > "$tmp"
+     echo "$tags" >> "$tmp"
+     echo "" >> "$tmp"
+     $EDITOR "$tmp"
+     head="$(sed -n '1p' "$tmp")" && body="$(sed '1,2d' "$tmp")" && tags="$(sed -n '2p' "$tmp")"
+ }
+ 
+ 
+ [ $(( ${#head} + ${#tags} )) -gt 5 ] || exit 1
+ 
+ recins -t note "$db" -f head -v "$head"
+ echo "Created entry $id"
+ message="$head"
+ 
+ [ -z "$body" ] || recset "$db" -t note -n "$id" -f body -a "$body"
+ 
+ for l in $links; do
+     recset "$db" -t note -n "$id" -f link -a "$l"
+ done
+ 
+ [ ! -z "$tags" ] || [ ! -t 0 ] || tags="$(recsel "$db" -t note -CP tag | sort -u | $FZF --multi --bind 'enter:accept-or-print-query' )"
+ 
+ for t in $tags; do
+     recset "$db" -t note -n "$id" -f tag -a "$t"
+ done
+ 
+ ########### Author
+ 
+ [ -z "$author" ] || (
+     export IFS=,
+     for a in $author; do
+         recset "$db" -t note -n "$id" -f author -a "$a"
+     done
+ )
+ 
+ ########### Quote
+ 
+ [ -z "$quote" ] || recset "$db" -t note -n "$id" -f quote -a "$quote"
+ 
+ ########### URL
+ 
+ [ -z "$url" ] || {
+     recset "$db" -t note -n "$id" -f url -a "$url"
+     [ -n "$parser" ] || {
+         echo Install offpunk
+         exit 2
+     } \
+     && netcache "$url" >/dev/null \
+     || echo "No article copied"
+ }
+ 
+ ########### File
+ 
+ [ -z "$file" ] || {
+     [ -r "$file" ] && recset "$db" -t note -n "$id" -f file -a "$file" || echo "No such file"
+ }
+ 
+ recfix "$db"
