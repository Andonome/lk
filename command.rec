aim: Show a script in HTML
cmd: source=~/.bashrc
+ target=bash.html
+ vim - --not-a-term -c '%TOhtml' -c "f ${target}" -c 'x!' -c 'qa!' < ${source}
shell: sh
bin: vim
tag: html
tag: documentation

aim: Read info files with vim
cmd: info () 
+ { 
+     [ -n "$1" ] && file="${1}" || file="$(ls /usr/share/info/ | sed 's/\.info.gz$//' | fzf )";
+     file="$(ls /usr/share/info/"$file"* | fzf -1 )"
+     vim "$file"
+ }
shell: sh
bin: vim
bin: info
tag: documentation

